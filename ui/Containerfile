FROM node:22.23.0 AS build
WORKDIR /build
# renovate: datasource=github-releases depName=NethServer/nethsecurity-ui
ARG UI_VERSION=2.25.0
RUN git init . \
    && git remote add origin https://github.com/NethServer/nethsecurity-ui \
    && git fetch --depth=1 origin "$UI_VERSION" \
    && git checkout FETCH_HEAD \
    && npm ci \
    && VITE_UI_MODE=controller npm run build

FROM docker.io/alpine:3.22.6 AS dist
RUN apk add --no-cache lighttpd
COPY entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
COPY --from=build /build/dist /var/www/localhost/htdocs
